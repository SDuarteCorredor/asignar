    {
      "parameters": {
        "jsCode": "// Normaliza la solicitud que llega del formulario de la web nueva.\n//\n// A diferencia del flujo de Gmail (que parsea el cuerpo de un correo con\n// expresiones regulares), aquí los campos llegan ya separados en el JSON del\n// webhook: no hay nada que adivinar y nada que se rompa si cambia el texto\n// del correo.\n\nconst cfg = $('⚙️ Configuración').first().json;\nconst src = $json.body || $json || {};\n\nconst txt = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst dato = (v) => txt(v) || '(sin dato)';\n\nconst empresa  = txt(src.empresa);\nconst nombre   = txt(src.nombre);\nconst email    = txt(src.email).toLowerCase();\nconst telefono = txt(src.telefono).replace(/[\\s()\\-]/g, '');\nconst ciudad   = txt(src.ciudad);\nconst servicio = txt(src.servicio);\nconst mensaje  = txt(src.mensaje) || 'Solicito una propuesta comercial.';\nconst origen   = txt(src.origen) || 'web';\nconst pagina   = txt(src.pagina);\n\n// Sin correo no hay a quién responderle: cae en la rama REVISAR.\nconst correoValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n// El texto de Paula vive en ⚙️ Configuración; aquí solo se personaliza.\nconst mensajeFinal = txt(cfg.replyBody)\n  .split('{{nombre}}').join(nombre)\n  .split('{{empresa}}').join(empresa || 'su empresa')\n  .split('{{ciudad}}').join(ciudad)\n  .split('{{linkAgenda}}').join(txt(cfg.linkAgenda));\n\nconst ahora = new Date();\nconst fechaLegible = ahora.toLocaleString('es-CO', {\n  timeZone: 'America/Bogota', dateStyle: 'full', timeStyle: 'short'\n});\n\n// Estas filas no vienen de un correo, así que no hay messageId de Gmail que\n// usar como identificador. Se genera uno propio con el mismo papel.\nconst id = 'web-' + ahora.getTime().toString(36) + '-' + Math.random().toString(36).slice(2, 7);\n\nconst dondeSeLlenó = origen === 'contacto' ? 'formulario de /contacto'\n                   : origen === 'servicios' ? 'formulario de /servicios'\n                   : 'formulario de la web (' + origen + ')';\n\nconst avisoPaula = [\n  correoValido\n    ? 'Nueva solicitud desde la página web. Ya se le envió el portafolio con el link para agendar.'\n    : 'Nueva solicitud desde la página web SIN correo válido: no se pudo enviar el portafolio. Hay que responder a mano.',\n  '',\n  'Empresa: ' + dato(empresa),\n  'Contacto: ' + dato(nombre),\n  'Correo: ' + (email || '(sin dato)'),\n  'Teléfono: ' + dato(telefono),\n  'Ciudad: ' + dato(ciudad),\n  'Servicio de interés: ' + dato(servicio),\n  '',\n  'Necesidad:',\n  mensaje,\n  '',\n  'Origen: ' + dondeSeLlenó,\n  pagina ? 'Página: ' + pagina : null,\n  'Recibida: ' + fechaLegible\n].filter((l) => l !== null).join('\\n');\n\nreturn [{ json: {\n  id,\n  origen,\n  pagina,\n  empresa,\n  nombre,\n  email,\n  telefono,\n  ciudad,\n  servicio,\n  mensaje,\n  correoValido,\n  mensajeFinal,\n  fechaISO: ahora.toISOString(),\n  fechaLegible,\n  estado: correoValido ? 'Portafolio enviado' : 'REVISAR - sin correo',\n  asuntoRegistro: 'Solicitud web - ' + (origen || 'web'),\n  observacion: 'Origen: ' + dondeSeLlenó + (servicio ? ' | Servicio: ' + servicio : ''),\n  asuntoAvisoPaula: (correoValido ? '[Comercial] Nueva solicitud web - ' : '[Comercial] REVISAR solicitud web - ')\n    + (empresa || email || 'sin empresa'),\n  avisoPaula\n}}];\n"
      },
      "id": "norm-solicitud",
      "name": "🧾 Normalizar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -920,
        420
      ]
    },
